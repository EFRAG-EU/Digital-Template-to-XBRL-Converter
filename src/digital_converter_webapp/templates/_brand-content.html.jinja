{# The results page's request for feedback, sent to config.BRAND_CONTACT_EMAIL. #}
{% macro feedbackRequest() %}
        <p class="text-sm text-blue-800">
            The EFRAG Secretariat is interested in your experience using this tool and in real VS and VSME disclosures for internal analytical purposes
            (any reports received by EFRAG will not be shared or published). Please feel free to send your report to
            <a href="mailto:{{ config.BRAND_CONTACT_EMAIL }}" class="underline font-medium hover:text-blue-600">{{ config.BRAND_CONTACT_EMAIL }}</a> – Thank you!
        </p>
{% endmacro %}
