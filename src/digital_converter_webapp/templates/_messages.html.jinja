{# The messages, a block for each section of the results (a stage of the
   conversion, an input file or a step run on the report), replaced in place as
   the steps finish. A section with warnings or errors starts open. #}
{% set state_words = {'pending': 'waiting', 'running': 'in progress'} %}
{% set ids = namespace(seen=[]) %}
<div id="messages" class="space-y-3">
{% for section in results.sections %}
    {% set base_id = "section-" ~ section.stage.value %}
    {% set repeats = ids.seen | select("equalto", base_id) | list | length %}
    {% set ids.seen = ids.seen + [base_id] %}
    {% set unfinished = section.state is defined and section.state.value in state_words %}
    {% set severity = section.getOverallSeverity() %}
    {% if unfinished %}
        {% set status, glyph, colours, icon = "In progress", "…", "border-blue-300 bg-blue-50", "bg-blue-400" %}
    {% elif section.isSkipped %}
        {% set status, glyph, colours, icon = "Not run", "–", "border-gray-300 bg-gray-100", "bg-gray-400" %}
    {% elif severity is sameas Severity.ERROR %}
        {% set status, glyph, colours, icon = "Errors", "✕", "border-red-300 bg-red-50", "bg-red-500" %}
    {% elif severity is sameas Severity.WARNING %}
        {% set status, glyph, colours, icon = "Warnings", "!", "border-amber-300 bg-amber-50", "bg-amber-500" %}
    {% else %}
        {% set status, glyph, colours, icon = "No problems", "✓", "border-gray-300 bg-gray-50", "bg-green-500" %}
    {% endif %}
    {% set messages = section.shownMessages(dev) %}
    <details id="{{ base_id }}{% if repeats %}-{{ repeats + 1 }}{% endif %}"
        class="group rounded-lg border {{ colours }}" {% if section.hasErrorsOrWarnings() %}open{% endif %}>
        <summary class="flex cursor-pointer select-none flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2">
            <span aria-hidden="true" class="text-gray-500 transition-transform group-open:rotate-90">▸</span>
            <span aria-hidden="true"
                class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white {{ icon }}">{{ glyph }}</span>
            <span class="sr-only">{{ status }}:</span>
            <span class="font-semibold text-gray-800">{{ section.label | e }}</span>
    {% if section.source is not none %}
            <span class="text-gray-600">{{ section.source | e }}</span>
    {% endif %}
            <span class="ml-auto text-sm text-gray-700">
    {% if unfinished %}
                {{ state_words[section.state.value] }}
    {% elif section.isSkipped %}
                not run
    {% else %}
                {{ section.severityCounts(dev) }}
    {% endif %}
            </span>
    {% if dev and section.durationNs is not none %}
            <span class="text-sm text-gray-500" title="Duration">{{ format_time_ns(section.durationNs) }}</span>
    {% endif %}
        </summary>
        <div class="space-y-2 overflow-x-auto border-t border-gray-200 bg-white p-3 rounded-b-lg">
    {% if not messages %}
            <p class="text-sm text-gray-600">{% if unfinished %}Not finished yet.{% else %}No messages.{% endif %}</p>
    {% endif %}
    {% for source, group in section.messagesBySource(dev) %}
        {% if source is not none %}
            <h4 class="pt-2 font-semibold text-gray-700">{{ source | e }}</h4>
        {% endif %}
        {# Only messages about the workbook have Excel references. #}
        {% set has_refs = group | selectattr("excelReference") | list | length > 0 %}
            {# Fixed widths, so every section's columns line up. #}
            <table class="table-fixed w-full border-collapse border border-gray-300 text-sm">
                <colgroup>
                    <col class="w-40">
                    <col class="w-28">
                    <col>
        {% if has_refs %}
                    <col class="w-48">
        {% endif %}
                </colgroup>
                <thead class="bg-gray-100">
                    <tr>
                        <th class="border border-gray-300 px-4 py-2 text-left">Message Type</th>
                        <th class="border border-gray-300 px-4 py-2 text-left">Severity</th>
                        <th class="border border-gray-300 px-4 py-2 text-left">Message</th>
        {% if has_refs %}
                        <th class="border border-gray-300 px-4 py-2 text-left">Excel Reference</th>
        {% endif %}
                    </tr>
                </thead>
                <tbody>
        {% for message in group %}
                    <tr class="hover:bg-gray-50">
                        <td class="border border-gray-300 px-4 py-2">{{ message.messageType.value | e }}</td>
                        <td class="border border-gray-300 px-4 py-2 text-center">
                            <span
                                class="px-2 py-1 rounded text-white {% if message.severity is sameas Severity.INFO %}bg-blue-500{% elif message.severity is sameas Severity.WARNING %}bg-amber-500{% elif message.severity is sameas Severity.ERROR %}bg-red-500{% endif %}">
                                {{ message.severity.value | e }}
                            </span>
                        </td>
                        <td class="border border-gray-300 px-4 py-2 wrap-break-word">{{ message.messageText | e }}</td>
            {% if has_refs %}
                        <td class="border border-gray-300 px-4 py-2 wrap-break-word">{{ (message.excelReference or "") | e }}</td>
            {% endif %}
                    </tr>
        {% endfor %}
                </tbody>
            </table>
    {% endfor %}
        </div>
    </details>
{% endfor %}
</div>
