{# The messages as one table, replaced in place as the steps finish: the flat
   RESULTS_LAYOUT. Developers see each section's progress as rows of its own,
   made from its timing, as the CLI prints it. #}
{% macro row(messageType, severity, text, excelReference=none) %}
        <tr class="hover:bg-gray-50">
            <td class="border border-gray-300 px-4 py-2">{{ messageType.value | e }}</td>
            <td class="border border-gray-300 px-4 py-2 text-center">
                <span
                    class="px-2 py-1 rounded text-white {% if severity is sameas Severity.INFO %}bg-blue-500{% elif severity is sameas Severity.WARNING %}bg-amber-500{% elif severity is sameas Severity.ERROR %}bg-red-500{% endif %}">
                    {{ severity.value | e }}
                </span>
            </td>
            <td class="border border-gray-300 px-4 py-2">{{ text | e }}</td>
    {% if excelReference is not none %}
            <td class="border border-gray-300 px-4 py-2">{{ excelReference | e }}</td>
    {% else %}
            <td class="border border-gray-300 px-4 py-2"></td>
    {% endif %}
        </tr>
{% endmacro %}
<table id="messages" class="table-auto w-full border-collapse border border-gray-300 text-sm">
    <thead class="bg-gray-100">
        <tr>
            <th class="border border-gray-300 px-4 py-2 text-left">Message Type</th>
            <th class="border border-gray-300 px-4 py-2 text-left">Severity</th>
            <th class="border border-gray-300 px-4 py-2 text-left">Message</th>
            <th class="border border-gray-300 px-4 py-2 text-left">Excel Reference</th>
        </tr>
    </thead>
    <tbody>
{% if dev %}
    {% for section in results.sections %}
        {% set started = not section.isSkipped and (section.state is not defined or section.state.value != "pending") %}
        {% if started %}
{{ row(MessageType.Progress, Severity.INFO, "Starting: [" ~ section.title ~ "].") }}
        {% endif %}
        {% for message in section.developerMessages %}
{{ row(message.messageType, message.severity, message.messageText, message.excelReference) }}
        {% endfor %}
        {% if started and section.durationNs is not none %}
{{ row(MessageType.Progress, Severity.INFO, "Finished: [" ~ section.title ~ "] in " ~ format_time_ns(section.durationNs) ~ ".") }}
        {% endif %}
    {% endfor %}
{% else %}
    {% for message in results.userMessages %}
{{ row(message.messageType, message.severity, message.messageText, message.excelReference) }}
    {% endfor %}
{% endif %}
    </tbody>
</table>
